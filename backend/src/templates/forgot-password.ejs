<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Password Reset OTP</title>
</head>

<body style="margin: 0; padding: 0; background-color: #f4f7fb; font-family: Arial, Helvetica, sans-serif; color: #333;">

    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="padding: 40px 15px;">
        <tr>
            <td align="center">

                <table width="100%" max-width="600px" cellpadding="0" cellspacing="0" border="0"
                    style="max-width: 600px; background-color: #ffffff; border-radius: 12px; overflow: hidden;">

                    <!-- Header -->
                    <tr>
                        <td align="center" style="padding: 30px 20px; background-color: #2563eb;">
                            <h1 style="margin: 0; color: #ffffff; font-size: 26px;">
                                Password Reset
                            </h1>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding: 35px 40px;">

                            <p style="margin: 0 0 15px; font-size: 16px;">
                                Hello <strong><%= name %></strong>,
                            </p>

                            <p style="margin: 0 0 25px; font-size: 15px; line-height: 1.6; color: #555;">
                                We received a request to reset the password for your account.
                                Use the One-Time Password (OTP) below to continue.
                            </p>

                            <!-- OTP -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td align="center" style="padding: 20px 0;">
                                        <div style="
                                            display: inline-block;
                                            padding: 15px 35px;
                                            background-color: #eff6ff;
                                            border: 1px solid #bfdbfe;
                                            border-radius: 8px;
                                            color: #2563eb;
                                            font-size: 32px;
                                            font-weight: bold;
                                            letter-spacing: 8px;
                                        ">
                                            <%= otp %>
                                        </div>
                                    </td>
                                </tr>
                            </table>

                            <p style="
                                text-align: center;
                                margin: 15px 0 25px;
                                font-size: 14px;
                                color: #666;
                            ">
                                This OTP will expire in
                                <strong><%= expireIn %> minutes</strong>.
                            </p>

                            <hr style="border: 0; border-top: 1px solid #eee; margin: 25px 0;">

                            <p style="margin: 0 0 10px; font-size: 14px; color: #666;">
                                <strong>Security Notice:</strong>
                            </p>

                            <p style="margin: 0; font-size: 13px; line-height: 1.6; color: #777;">
                                Never share this OTP with anyone. Our team will never ask you
                                for your OTP or password.
                            </p>

                            <p style="margin: 25px 0 0; font-size: 14px; color: #555;">
                                If you did not request a password reset, you can safely ignore
                                this email.
                            </p>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" style="padding: 20px; background-color: #f8fafc;">
                            <p style="margin: 0; font-size: 12px; color: #999;">
                                © 2026  Company. All rights reserved.
                            </p>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>
</html>