<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome</title>
</head>

<body style="margin: 0; padding: 0; background-color: #f4f7fb; font-family: Arial, Helvetica, sans-serif; color: #333;">

    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="padding: 40px 15px;">
        <tr>
            <td align="center">

                <table width="100%" cellpadding="0" cellspacing="0" border="0"
                    style="max-width: 600px; background-color: #ffffff; border-radius: 12px; overflow: hidden;">

                    <!-- Header -->
                    <tr>
                        <td align="center" style="padding: 35px 20px; background-color: #2563eb;">
                            <h1 style="margin: 0; color: #ffffff; font-size: 28px;">
                                Welcome Aboard!
                            </h1>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding: 40px;">

                            <p style="margin: 0 0 20px; font-size: 17px;">
                                Hello <strong><%= name %></strong>,
                            </p>

                            <p style="margin: 0 0 20px; font-size: 15px; line-height: 1.7; color: #555;">
                                Welcome to <strong> Company</strong>! 🎉
                            </p>

                            <p style="margin: 0 0 25px; font-size: 15px; line-height: 1.7; color: #555;">
                                Your account has been successfully created and your email
                                address has been verified. We're excited to have you with us!
                            </p>

                            <!-- Success Message -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0"
                                style="margin: 25px 0;">
                                <tr>
                                    <td style="
                                        padding: 18px;
                                        background-color: #f0fdf4;
                                        border: 1px solid #bbf7d0;
                                        border-radius: 8px;
                                        text-align: center;
                                    ">
                                        <p style="
                                            margin: 0;
                                            color: #15803d;
                                            font-size: 15px;
                                            font-weight: bold;
                                        ">
                                            ✓ Account created & email verified successfully
                                        </p>
                                    </td>
                                </tr>
                            </table>

                            <p style="margin: 0 0 15px; font-size: 15px; line-height: 1.7; color: #555;">
                                You can now log in and start exploring everything
                                we have to offer.
                            </p>

                            <p style="margin: 25px 0 0; font-size: 15px; line-height: 1.7; color: #555;">
                                Thank you for choosing us. We look forward to being
                                part of your journey!
                            </p>

                            <p style="margin: 30px 0 0; font-size: 15px; color: #555;">
                                Best regards,<br>
                                <strong> Company Team</strong>
                            </p>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" style="padding: 20px; background-color: #f8fafc;">
                            <p style="margin: 0; font-size: 12px; color: #999;">
                                © 2026  Company. All rights reserved.
                            </p>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>
</html>